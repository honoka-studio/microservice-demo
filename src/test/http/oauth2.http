POST {{url_prefix.gateway}}/auth/login
Content-Type: application/json

{
  "username": "user2",
  "password": "password2"
}

> {% client.global.set('login_id', response.body['data']['loginId']) %}

###
GET {{url_prefix.gateway}}/auth/oauth2/authorize
    ?response_type=code
    &client_id=microservice-demo-web
    &scope=all
    &redirect_uri=http%3A%2F%2Flocalhost%3A8080%2Fauth%2Foauth2%2Fcallback
X-Login-ID: {{login_id}}

> {% client.global.set('auth_code', response.body['data']['code']) %}

###
POST {{url_prefix.gateway}}/auth/oauth2/token
Content-Type: application/x-www-form-urlencoded
# Authorization的值为clientId与clientSecret（原文），用冒号拼接，然后base64编码
Authorization: Basic {{oauth2_api_auth}}

grant_type=authorization_code
&code={{auth_code}}
&redirect_uri=http%3A%2F%2Flocalhost%3A8080%2Fauth%2Foauth2%2Fcallback

> {%
  client.global.set('token_type', response.body['token_type'])
  client.global.set('access_token', response.body['access_token'])
  client.global.set('refresh_token', response.body['refresh_token'])
%}

###
POST {{url_prefix.gateway}}/auth/oauth2/token
Content-Type: application/x-www-form-urlencoded
Authorization: Basic {{oauth2_api_auth}}

grant_type=refresh_token
&refresh_token={{refresh_token}}

> {%
  client.global.set('token_type', response.body['token_type'])
  client.global.set('access_token', response.body['access_token'])
  client.global.set('refresh_token', response.body['refresh_token'])
%}

###
POST {{url_prefix.gateway}}/auth/oauth2/revoke
Content-Type: application/x-www-form-urlencoded
Authorization: Basic {{oauth2_api_auth}}

token_type_hint=refresh_token
&token={{refresh_token}}

###
GET {{url_prefix.gateway}}/auth/logout
Authorization: {{token_type}} {{access_token}}
